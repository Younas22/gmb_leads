APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Third-party API keys (never hardcode these in source)
GOOGLE_PAGESPEED_API_KEY=
UNIRATE_API_KEY=

# Security switches — keep false in production
ALLOW_WEB_MAINTENANCE_COMMANDS=false
ALLOW_WEB_ENV_EDITING=false

# AI (Phase 1 foundation). AI stays off until ANTHROPIC_API_KEY is set.
AI_ENABLED=true
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-opus-5-5
AI_MAX_TOKENS=16000
AI_EFFORT=medium
AI_REFUSAL_FALLBACKS=true
AI_TIMEOUT=75
AI_CONNECT_TIMEOUT=10
# Keep 0: retries happen at job level. Worst case per job = (1+retries) x 2 calls x AI_TIMEOUT must stay below AI_JOB_TIMEOUT.
AI_MAX_RETRIES=0
AI_QUEUE_CONNECTION=ai_database
AI_QUEUE=ai
AI_JOB_TIMEOUT=170
AI_QUEUE_RETRY_AFTER=210

# Phase 3: Gmail sending (OAuth client in Google Cloud; scope gmail.send only).
# Use a DEDICATED OAuth client (not the Google Login one); sending stays off until both are set.
# Set GMAIL_REDIRECT_URI explicitly in production (https) and register it exactly in Google Cloud:
# https://your-domain/user/email-sending/google/callback
# Packages need gmail_sending_enabled=1 (default OFF) and email_sends_daily=N (account-wide/day).
GMAIL_SENDING_ENABLED=true
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_PER_MINUTE=5
MAIL_SEND_QUEUE_CONNECTION=mail_database
MAIL_SEND_QUEUE=mail
MAIL_SEND_QUEUE_RETRY_AFTER=120
